#  the background run: one chain decays in the tube wall, every step it deposits in the germanium is recorded
#    remage -q --ignore-warnings -t 8 -w -o output/tl208.root -s GDML=$G -s Z=81 -s A=208 -s NEV=1000000 -s SEED=1 -s VOLS='reentrancetube|ofhc_cu|ss_316l' -- sim/run.mac
#  aliases: {GDML} here, {Z} {A} {NEV} {SEED} {VOLS} in sim/source.mac

#-------------------------------------------------------------------------------
#  1. Before init:
/RMG/Geometry/RegisterDetectorsFromGDML Germanium   # the detector map comes from inside the GDML
/RMG/Output/NtupleUseVolumeName true                # names the trees V0101 etc rather than det101
/RMG/Processes/EnableGammaAngularCorrelation        # physics-list settings are PreInit-only
/RMG/Geometry/GDMLDisableOverlapCheck true          # overlaps are checked with the geometry, in l1000_geometry/
/RMG/Geometry/IncludeGDMLFile {GDML}
/run/initialize

#-------------------------------------------------------------------------------
#  2. After init:
/geometry/navigator/check_mode false
/RMG/Output/Germanium/DiscardZeroEnergyHits true
/RMG/Output/Germanium/EdepCutLow 0 keV              # drop the Ge rows of events that left nothing in germanium (~99%). vertices are always written, so every decay still counts
/RMG/Output/Germanium/StoreSinglePrecisionPosition
/RMG/Output/Germanium/StoreSinglePrecisionEnergy
/RMG/Output/Vertex/StoreSinglePrecisionPosition
/control/execute sim/source.mac                     # path from rt/, where remage is launched
