#  CONFIG ge: germanium energy deposits

#-------------------------------------------------------------------------------
#  1. Before init:
/RMG/Geometry/RegisterDetectorsFromGDML Germanium   # detector map comes from inside the GDML
/RMG/Output/NtupleUseVolumeName true                # names the trees V0101 etc rather than det101
/RMG/Processes/EnableGammaAngularCorrelation        # physics-list settings are PreInit-only, after /run/initialize Geant4 says "Illegal application state"
/RMG/Geometry/GDMLDisableOverlapCheck true          # costs minutes per job, checked once on its own by geo_check.mac
/RMG/Geometry/IncludeGDMLFile {GDML}
/run/initialize

#-------------------------------------------------------------------------------
#  2. After init:
/geometry/navigator/check_mode false
/RMG/Output/Germanium/DiscardZeroEnergyHits true
/RMG/Output/Germanium/StoreSinglePrecisionPosition
/RMG/Output/Germanium/StoreSinglePrecisionEnergy
/RMG/Output/Vertex/StoreSinglePrecisionPosition
# /RMG/Output/Germanium/EdepCutLow 1000 keV         # shrinks the output a lot at high stats, but drops the events sim_reach.C needs for its denominator. leave off while validating
/control/execute src_events.mac
