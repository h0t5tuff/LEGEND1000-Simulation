#  does the KS geometry build, and does anything overlap? two modes, one file

#    fast build only, ~6 s 
#      remage -q --ignore-warnings -s GDML=$G -s SKIP=true  -s NPOINTS=1000  -- geom/check.mac

#    full overlap scan, ~3 min (for finer scan, increase the points)
#      remage    --ignore-warnings -s GDML=$G -s SKIP=false -s NPOINTS=1000  -- geom/check.mac 2>&1 | grep "Overlap is detected"

#-------------------------------------------------------------------------------
/RMG/Geometry/RegisterDetectorsFromGDML Germanium   # the KS file carries the pygeomtools map, so no hand-written dets macro
/RMG/Geometry/GDMLDisableOverlapCheck {SKIP}        # checking is ON by default in remage. the old rt macros all set this true, which is why flagged overlaps never showed up
/RMG/Geometry/GDMLOverlapCheckNumPoints {NPOINTS}   # ignored when SKIP=true, so it is safe to pass either way
/RMG/Geometry/IncludeGDMLFile {GDML}
/run/initialize
