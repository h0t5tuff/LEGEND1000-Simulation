#  the RT background source: one decay chain, uniformly through the RT sections named in {VOLS}
#  /control/execute'd AFTER /run/initialize by run.mac. aliases: {Z} {A} {NEV} {SEED} {VOLS}
#    Tl208 -> -s Z=81 -s A=208      Bi214 -> -s Z=83 -s A=214
#    whole tube -> -s VOLS='reentrancetube|ofhc_cu|ss_316l'      one section -> -s VOLS=ss_316l (or ofhc_cu, reentrancetube)

#-------------------------------------------------------------------------------
#  1. Confine to the RT wall:
/RMG/Manager/Randomization/Seed {SEED}
/RMG/Generator/Confine Volume
/RMG/Generator/Confinement/MaxSamplingTrials 100000        # the wall is a thin shell (1.5 mm EFCu, 6 mm OFHC/SS) so uniform-by-volume needs ~560 tries per vertex. the default is far too low and the sampler gives up
/RMG/Generator/Confinement/Physical/AddVolume {VOLS}        # a regex over physical volumes: reentrancetube = EFCu mother (endcap, lower wall, top lid), ofhc_cu and ss_316l = the shells inside it. one section alone is how to buy statistics where the seams are decided
# vertex xyz lands in stp/vtx: background.C reads its depth (the design slab) and its physical volume (the MC density)

#-------------------------------------------------------------------------------
#  2. The decaying nucleus:
/RMG/Generator/Select GPS
/gps/particle ion
/gps/energy 0 eV        # the ion is created at rest, all the energy comes from the decay
/gps/ion {Z} {A}
/process/had/rdm/nucleusLimits {A} {A} {Z} {Z}   # decay THIS nuclide only, do not follow the rest of the chain
/run/beamOn {NEV}
