#  the RT background source: one decay chain, uniformly through all three RT sections
#  /control/execute'd AFTER /run/initialize by sim_run.mac. aliases: {Z} {A} {NEV} {SEED}
#    Tl208 -> -s Z=81 -s A=208      Bi214 -> -s Z=83 -s A=214

#-------------------------------------------------------------------------------
#  1. Confine to the RT wall:
/RMG/Manager/Randomization/Seed {SEED}
/RMG/Generator/Confine Volume
/RMG/Generator/Confinement/MaxSamplingTrials 100000        # the wall is a thin shell (1.5 mm EFCu, 6 mm OFHC/SS) so uniform-by-volume needs ~560 tries per vertex. the default is far too low and the sampler gives up
/RMG/Generator/Confinement/Physical/AddVolume reentrancetube   # EFCu mother: endcap, lower wall AND the top lid
/RMG/Generator/Confinement/Physical/AddVolume ofhc_cu          # OFHC shell, placed inside the mother
/RMG/Generator/Confinement/Physical/AddVolume ss_316l          # SS shell. confining to only one of the three fills only that section, which was the stall
# vertex xyz lands in stp/vtx: sim_background.C reads its depth (the design slab) and its physical volume (the MC density)

#-------------------------------------------------------------------------------
#  2. The decaying nucleus:
/RMG/Generator/Select GPS
/gps/particle ion
/gps/energy 0 eV        # the ion is created at rest, all the energy comes from the decay
/gps/ion {Z} {A}
/process/had/rdm/nucleusLimits {A} {A} {Z} {Z}   # decay THIS nuclide only, do not follow the rest of the chain
/run/beamOn {NEV}
