# /vis/geometry/set/colour <logical-volume> <depth> R G B alpha
# read by l200-vis.mac (Geant4) and l200-autopeel.py (VTK), in the autopeel's layer order

# ── cryostat: outer steel wall
/vis/geometry/set/colour cryostat_outer_wall 0 0.55 0.57 0.6 1

# ── cryostat: vacuum insulation between the two walls
/vis/geometry/set/colour cryostat_vacuum_gap 0 0.55 0.55 0.62 1

# ── cryostat: inner steel wall
/vis/geometry/set/colour cryostat_inner_wall 0 0.55 0.57 0.6 1

# ── gaseous argon (top fill)
/vis/geometry/set/colour gaseous_argon 0 0.7 0.88 1 1

# ── liquid argon bath
/vis/geometry/set/colour liquid_argon 0 0.55 0.8 1 1

# ── WLS reflector: TPB coating
