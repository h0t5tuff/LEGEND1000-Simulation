# /vis/geometry/set/colour <logical-volume> <depth> R G B alpha
# read by l1000-vis.mac (Geant4) and l1000-autopeel.py (VTK); one line per LV of output/l1000.gdml

# ── steel cryostat and supports
/vis/geometry/set/colour cryostat_foot_steel_316L 0 0.55 0.57 0.6 1
/vis/geometry/set/colour cryostat_inner_steel_316L 0 0.55 0.57 0.6 1
/vis/geometry/set/colour cryostat_outer_steel_316L 0 0.55 0.57 0.6 1
/vis/geometry/set/colour cryostat_skirt_steel_316L 0 0.55 0.57 0.6 1

# ── re-entrant tube upper section (SS 316L, z 2925..4987): bluer than the cryostat steel
/vis/geometry/set/colour reentrance_tube_layer_steel_316L 0 0.50 0.56 0.66 1

# ── vacuum insulation between the two tanks
/vis/geometry/set/colour cryostat_insulation_vacuum 0 0.55 0.55 0.62 1

# ── atmospheric LAr (outer bath)
/vis/geometry/set/colour liquid_argon_atmospheric 0 0.55 0.8 1 1

# ── neutron moderator
/vis/geometry/set/colour neutron_moderator_pmma 0 0.65 0.55 0.3 1

# ── outer WLS reflector: tetratex white, TPB light blue
/vis/geometry/set/colour atmospheric_wlsr_tetratex 0 0.96 0.96 0.96 1
/vis/geometry/set/colour atmospheric_wlsr_tpb 0 0.6 0.9 1 1

# ── re-entrant tube lower section + endcap (EFCu mother, exposed z -1259..920): bright copper
/vis/geometry/set/colour reentrance_tube_copper 0 0.85 0.45 0.12 1

# ── re-entrant tube mid section (OFHC Cu, z 920..2925): darker than the EFCu
/vis/geometry/set/colour reentrance_tube_layer_copper_ofhc 0 0.55 0.25 0.08 1

# ── underground LAr (inner active bath)
/vis/geometry/set/colour liquid_argon_underground 0 0.55 0.8 1 1

# ── inner WLS reflector: tetratex white, TPB light blue
/vis/geometry/set/colour underground_wlsr_tetratex 0 0.96 0.96 0.96 1
/vis/geometry/set/colour underground_wlsr_tpb 0 0.6 0.9 1 1

# ── WLS fibres
/vis/geometry/set/colour fiber_cl1_l1349.00 0 0.4 0.9 0.45 1
/vis/geometry/set/colour fiber_cl2_l1349.00 0 0.4 0.9 0.45 1
/vis/geometry/set/colour fiber_coating_tpb_l1349.00_tpb1093 0 0.4 0.9 0.45 1
/vis/geometry/set/colour fiber_core_l1349.00 0 0.4 0.9 0.45 1

