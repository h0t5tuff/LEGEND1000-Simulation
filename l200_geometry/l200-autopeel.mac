/vis/geometry/set/visibility hpge_assembly_insulator_ultem_8.23 0 false
/vis/geometry/set/visibility hpge_assembly_insulator_ultem_8.25 0 false
/vis/geometry/set/visibility hpge_assembly_insulator_ultem_8.26 0 false
/vis/geometry/set/visibility hpge_assembly_insulator_ultem_8.28 0 false
/vis/geometry/set/visibility hpge_assembly_insulator_ultem_8.65 0 false
/vis/geometry/set/visibility hpge_assembly_insulator_ultem_8.70 0 false
/vis/geometry/set/visibility hpge_assembly_insulator_ultem_8.85 0 false
/vis/geometry/set/visibility hpge_assembly_insulator_ultem_8.95 0 false
/vis/geometry/set/visibility hpge_assembly_insulator_ultem_9.00 0 false
/vis/geometry/set/visibility hpge_assembly_insulator_ultem_9.01 0 false
/vis/geometry/set/visibility ultem_clamp_hv 0 false
/vis/geometry/set/visibility ultem_clamp_signal 0 false

# ═ STEP 15/19
# ── FADE 15/17 (hide/cull): PEN holder plates (6 vols)
/vis/viewer/interpolate interpolation/dwell 10 300 millisecond
/vis/geometry/set/visibility pen_large 0 false
/vis/geometry/set/visibility pen_medium 0 false
/vis/geometry/set/visibility pen_medium_ortec 0 false
/vis/geometry/set/visibility pen_ppc_small 0 false
/vis/geometry/set/visibility pen_small 0 false
/vis/geometry/set/visibility pen_xlarge 0 false

# ═ STEP 16/19
# ── FLIP: fast tumble over the top to 45 deg below the array, image upside down,
#    so the detector bottoms and the LMFEs under them face the camera
/vis/viewer/interpolate interpolation/flip 3 0 millisecond
# interpolate restores the starting view when done, so pin the flipped end state
/vis/viewer/set/upVector 0 0 -1
/vis/viewer/set/viewpointThetaPhi 135 200 deg
/vis/viewer/set/lightsThetaPhi 135 200 deg

# ═ STEP 17/19
# ── FADE 16/17 (hide/cull): LMFE front-end electronics (1 vols)
/vis/viewer/interpolate interpolation/dwell 10 300 millisecond
/vis/geometry/set/visibility lmfe 0 false

# ═ STEP 18/19
# ── FADE 17/17 (hide/cull): springs and washers (2 vols)
/vis/viewer/interpolate interpolation/dwell 10 300 millisecond
/vis/geometry/set/visibility phbr_spring 0 false
/vis/geometry/set/visibility phbr_washer 0 false

# ═ STEP 19/19
# ── STAR: dwell on what remains — the 101 HPGe detectors (B*, C*, P*, V*)
/vis/viewer/interpolate interpolation/dwell 10 300 millisecond
