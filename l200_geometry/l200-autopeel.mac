# ══════════════════════════════════════════════════════════════════════════
# remage -i l200-vis.mac
# /control/execute l200-autopeel.mac
# Peel order (FADE ids = narration table rows):
#   1,2,3,6,5,4,8,7,11,9,10,12,13,14,15, FLIP, 16,17, STAR
# RESET afterwards:  /vis/geometry/set/visibility world -1 true
#                    /vis/viewer/set/upVector 0 0 1
#                    /vis/viewer/set/viewpointThetaPhi 70 20 deg
#                    /vis/viewer/set/lightsThetaPhi 70 20 deg
# ══════════════════════════════════════════════════════════════════════════
# ═ STEP 1/19
# ── FADE 1/17 (hide/cull): outer steel barrel (cryostat) (1 vols)
/vis/viewer/interpolate interpolation/dwell 10 300 millisecond
/vis/geometry/set/visibility cryostat_steel 0 false

# ═ STEP 2/19
# ── FADE 2/17 (hide/cull): gaseous argon (top fill) (1 vols)
/vis/viewer/interpolate interpolation/dwell 10 300 millisecond
/vis/geometry/set/visibility gaseous_argon 0 false

# ═ STEP 3/19
# ── FADE 3/17 (hide/cull): liquid argon bath (1 vols)
/vis/viewer/interpolate interpolation/dwell 10 300 millisecond
/vis/geometry/set/visibility liquid_argon 0 false

# ═ STEP 4/19
# ── FADE 6/17 (hide/cull): WLSR TPB coating (1 vols)
/vis/viewer/interpolate interpolation/dwell 10 300 millisecond
/vis/geometry/set/visibility wlsr_tpb 0 false

# ═ STEP 5/19
# ── FADE 5/17 (hide/cull): WLSR tetratex reflector (1 vols)
/vis/viewer/interpolate interpolation/dwell 10 300 millisecond
/vis/geometry/set/visibility wlsr_tetratex 0 false

# ═ STEP 6/19
# ── FADE 4/17 (hide/cull): WLSR copper shell (1 vols)
/vis/viewer/interpolate interpolation/dwell 10 300 millisecond
/vis/geometry/set/visibility wlsr_copper 0 false

