# RUN
#   remage -i l1000-vis.mac

# PEELING
#   /control/execute l1000-autopeel.mac

# Define LV, then hide/show
#   /control/alias LV <LogicalVolumeName>
# /control/execute toggles/0.mac
#   /control/execute toggles/XLV.mac
#   /control/execute toggles/OLV.mac

#   /control/alias MAT <Group>
#   /control/execute toggles/MAT.mac
# ════════════════════════════════════════════════════════════════════
# geom & dets
/RMG/Geometry/GDMLDisableOverlapCheck true
/RMG/Geometry/IncludeGDMLFile l1000.gdml
/control/execute l1000-dets.mac
/run/initialize

# open Qt viewer
/vis/open OGL
/vis/viewer/set/lineSegmentsPerCircle 12
/control/execute l1000-colors.mac
/vis/drawVolume
/vis/viewer/set/style surface
/vis/viewer/set/upVector 0 0 1
/vis/viewer/set/viewpointThetaPhi 70 20 deg
/vis/viewer/set/lightsThetaPhi 70 20 deg
/vis/viewer/set/autoRefresh true
/vis/viewer/zoom 1
# ════════════════════════════════════════════════════════════════════
# Order LogicalVolumeName                                         Material                            #LVs  Note
#  –    world                                                     G4_Galactic                         1     vacuum (not a component)
#  1    outercryostat, skirt, foot                                metal_steel                         3     outer steel cryostat + supports
#  2    vacuumgap                                                 vacuum                              1     gap between the two steel shells
#  3    innercryostat                                             metal_steel                         1     inner cryostat
#  4    atmosphericlar                                            LiquidArgon                         1     atmospheric LAr (outer passive bath)
#  5    neutronmoderator                                          pmma                                1     transparent organic polymer (n moderator, elastic scattering)
#  6    wls_tetratex_outer_atmospheric_lv,                        tetratex+tpb_on_tetratex            2     outer WLS shroud (reflector + TPB)
#         wls_tpb_outer_atmospheric_lv
#  7    reentrancetube, ofhc_cu, ss_316l                          metal_copper+metal_steel            3     RT wall stack enclosing active LAr;
#                                                                                                           EFCu mother z −1327…852, OFHC
#                                                                                                           852…2857, SS 2857…4919 (seam z's)
#  8    undergroundlar                                            LiquidArgon                         1     underground LAr (ACTIVE bath)
#  9    wls_tetratex_inner_argon_lv,                              tetratex+tpb_on_tetratex            2     inner WLS shroud (reflector + TPB)
#         wls_tpb_inner_argon_lv
# 10    fiber_core_l1349_bNone, fiber_cl1_l1349_bNone,            ps_fibers+pmma+pmma_cl2             4     double-clad WLS fibre: PS core +
#         fiber_cl2_l1349_bNone, fiber_coating_l1349_tpb1093      +tpb_on_fibers+metal_copper         2     PMMA clads + TPB coat (×12,096)
# 11    hpge_support_copper_{weldment_top,rod_string,                                                 1053  string Cu hardware: weldments 336,
#         string_support_structure}, cable_{signal,hv}_V*,                                                  cables 336+336, rods 42, sipm mounts
#         sipm_outer_{top,bottom}_*                                                               
# 12    ultem_{insulator_du_holder,clamp_signal,                  ultem                               1008  DU holders + signal/HV clamps
#         clamp_hv}_V*                                                                                      (336 each; radiopure PEI)
# 13    pen_xlarge, hpge_support_copper_tristar_xlarge            pen                                 2     PEN detector holders (scintillating)
# 14    signal_asic_V*  (V0101 …)                                 silica                              336   front-end signal ASICs, 1/detector
# 15    sipm_r52.750000001_nmod3                                  metal_silicon                       1     SiPM photosensor (placed ×252)
#  –    V*  (V0101 …,)                                            EnrichedGermanium0.900              336   HPGe detectors — 90% ⁷⁶Ge target
# ────────────────────────────────────────────────────────────────────────────────────
# TOTAL LVs = 2756 ( 1+3+1+1+1+1+2+3+1+2+4+1053+1008+2+336+1+336 );  _V* = per-channel numeric id
# Readout (l1000-dets.mac, 590): 336 Germanium (V0xxx) + 252 Optical (sipm ×252) + 2 Scintillator (2 LAr baths)