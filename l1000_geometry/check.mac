#  does a LEGEND-1000 GDML build, and does anything overlap? two modes, one file. run from here

#    fast build only, ~6 s 
#      remage -q --ignore-warnings -s GDML=l1000.gdml -s SKIP=true  -s NPOINTS=1000  -- check.mac

#    full overlap scan, ~3 min (for finer scan, increase the points)
#      remage    --ignore-warnings -s GDML=l1000.gdml -s SKIP=false -s NPOINTS=1000  -- check.mac 2>&1 | grep "Overlap is detected"
#    any other file: -s GDML=../KSendcap_l1kGeometry.gdml

#-------------------------------------------------------------------------------
/RMG/Geometry/RegisterDetectorsFromGDML Germanium   # the GDML carries the pygeomtools map, so no hand-written dets macro
/RMG/Geometry/GDMLDisableOverlapCheck {SKIP}        # checking is ON by default in remage; a run that sets this true never sees an overlap
/RMG/Geometry/GDMLOverlapCheckNumPoints {NPOINTS}   # ignored when SKIP=true, so it is safe to pass either way
/RMG/Geometry/IncludeGDMLFile {GDML}
/run/initialize
